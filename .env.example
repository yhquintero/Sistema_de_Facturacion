# Node >=22.13. Copia este archivo a .env y adapta los valores.
PORT=3000
DATA_DIR=./data

# Contraseña del PRIMER administrador (>=12 caracteres). Solo se usa si aún no hay cuentas:
# después, cada persona entra con su usuario y el equipo se gestiona en «Usuarios y acceso».
# Sin cuentas ni contraseña, el desarrollo funciona en modo abierto (solo datos ficticios).
# No reutilices esta contraseña en otros servicios. No la publiques ni la compartas por chat.
APP_PASSWORD=
# Usuario de ese primer administrador.
ADMIN_USERNAME=admin

# false = espacio nuevo vacío (sin clientes, contratos ni firmas de ejemplo).
# true = datos demostrativos. Solo se aplica a una base de datos nueva.
SEED_DEMO=false

# Solo para una demostración pública SIN datos reales. No sustituye APP_PASSWORD.
ALLOW_PUBLIC_DEMO=false

# Usa 1 exclusivamente detrás de UN proxy de confianza con HTTPS.
TRUST_PROXY=0

# ---------------------------------------------------------------- Seguridad
# Cierre de sesión por inactividad (minutos; 0 lo desactiva) y duración máxima (horas).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# Bloqueo temporal por usuario+IP tras N intentos fallidos (contraseña o código 2FA).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5
# true = los administradores deben activar la verificación en dos pasos antes de continuar.
REQUIRE_ADMIN_2FA=false
# Quién puede mostrar Nexo dentro de un <iframe> (CSP frame-ancestors). Solo producción.
# Ej.: self · none · self https://intranet.ejemplo.com
FRAME_ANCESTORS=self

# ---------------------------------------------------------------- Copias de seguridad
# Clave de cifrado AES-256-GCM (>=16 caracteres). Sin ella las copias se guardan SIN cifrar.
# Guárdala en un gestor de contraseñas FUERA del servidor: sin la clave no se pueden restaurar.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BACKUP_KEY=
# Copias que se conservan (las más antiguas se eliminan) y hora local de la copia diaria.
BACKUP_KEEP=30
BACKUP_HOUR=2
# false = desactiva la copia automática diaria en producción.
BACKUP_AUTO=true
# Directorio de las copias; por defecto DATA_DIR/backups. Mejor en otro disco.
# BACKUP_DIR=/ruta/a/otro/disco/nexo-backups
