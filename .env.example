# Node >=22.13. Copia este archivo a .env y adapta los valores.
PORT=3000
DATA_DIR=./data

# Contraseña del PRIMER administrador (>=12 caracteres). Solo se usa si aún no hay cuentas:
# después, cada persona entra con su usuario y el equipo se gestiona en «Usuarios y acceso».
# Sin cuentas ni contraseña, el desarrollo funciona en modo abierto (solo datos ficticios).
# No reutilices esta contraseña en otros servicios. No la publiques ni la compartas por chat.
APP_PASSWORD=
# Usuario de ese primer administrador.
ADMIN_USERNAME=admin

# false = espacio nuevo vacío (sin clientes, contratos ni firmas de ejemplo).
# true = datos demostrativos. Solo se aplica a una base de datos nueva.
SEED_DEMO=false

# Solo para una demostración pública SIN datos reales. No sustituye APP_PASSWORD.
ALLOW_PUBLIC_DEMO=false

# Usa 1 exclusivamente detrás de UN proxy de confianza con HTTPS.
TRUST_PROXY=0
