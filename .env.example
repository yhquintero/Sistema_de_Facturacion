# Node >=22.13. Copiar a .env solo en el equipo servidor; nunca versionar .env ni secretos.
# El panel PowerShell usa su propia configuración privada, NO carga este archivo.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
SEED_DEMO=false
ALLOW_PUBLIC_DEMO=false

# Producción: proxy HTTPS con IP/CIDR EXACTOS y puerto interno no expuesto.
TLS_MODE=proxy
PUBLIC_ORIGIN=https://facturacion.tu-dominio-propio.cu
ALLOWED_ORIGINS=
TRUST_PROXY=127.0.0.1/32,::1/128
FRAME_ANCESTORS='none'

# Preferido: hash scrypt creado mediante stdin con npm run password:hash.
APP_PASSWORD_HASH_FILE=./secrets/access.scrypt
# Compatibilidad temporal (no recomendada); no usar contraseña en argumentos/URL.
APP_PASSWORD_FILE=
APP_PASSWORD=
BACKUP_KEY_FILE=./secrets/backup.key

# No poner CU sin comprobar residencia física y réplicas/copias.
DATA_LOCATION_COUNTRY=UNCONFIRMED
DATA_LOCATION_LEGAL_EXCEPTION_REFERENCE=
DATA_CONTROLLER_NAME=
PRIVACY_CONTACT=

# TLS directo alternativo: TLS_MODE=direct, PORT=8443 y un PUBLIC_ORIGIN cuyo SAN coincida.
TLS_CERT_FILE=
TLS_KEY_FILE=
REDIRECT_HTTP_PORT=

# Excepción SOLO laboratorio en loopback. No habilitar para LAN ni Internet.
ALLOW_INSECURE_LOCALHOST=false

# Docker avanzado (ver compose.yaml y docs/OPERACION-SEGURA.md):
# NEXO_DOMAIN=facturacion.tu-dominio-propio.cu
# NEXO_PUBLIC_ORIGIN=https://facturacion.tu-dominio-propio.cu
# NEXO_BIND_IP=127.0.0.1
# NEXO_ACCESS_HASH_FILE=/ruta/privada/access.scrypt
# NEXO_BACKUP_KEY_FILE=/ruta/privada/backup.key

# Solo se usa al crear la primera cuenta; nunca sustituye las cuentas existentes.
ADMIN_USERNAME=admin
