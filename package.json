{
  "name": "sistema-de-facturacion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Facturación Profesional Multiplataforma (Web, Servidor, Móvil) con Desglose Técnico de Desarrollo e Instalación y Exportación Internacional (.docx, .xlsx, .pdf)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts create",
    "backup:verify": "node --env-file-if-exists=.env --import tsx scripts/backup.ts verify",
    "backup:restore": "node --env-file-if-exists=.env --import tsx scripts/backup.ts restore",
    "user:reset-password": "node --env-file-if-exists=.env --import tsx scripts/reset-password.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "pdfkit": "^0.16.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
